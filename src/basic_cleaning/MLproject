name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: W&B input artifact name (e.g. 'sample.csv:latest')
        type: string

      output_artifact:
        description: Name for the output artifact to create in W&B
        type: string

      output_type:
        description: W&B artifact type for the output
        type: string

      output_description:
        description: Description for the output artifact
        type: string

      min_price:
        description: Minimum price to keep
        type: float

      max_price:
        description: Maximum price to keep
        type: float

    command: 
      "python run.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description} --min_price {min_price} --max_price {max_price}"